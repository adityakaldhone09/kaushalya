APP_NAME=KAUSHALYA
ENVIRONMENT=development

HOST=0.0.0.0
PORT=8000

# MongoDB - use local or Atlas
MONGODB_URI=mongodb://localhost:27017/kaushalya_db
MONGODB_DB_NAME=kaushalya_db

# JWT - replace with a long random secret in production
JWT_SECRET=replace_with_a_very_long_and_secure_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma-separated origins
FRONTEND_URL=http://localhost:5173

# LLM - optional; leave blank to use deterministic fallback
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=KAUSHALYA
SMTP_USE_TLS=true
EMAIL_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Google OAuth (do not expose the client secret to the frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173
